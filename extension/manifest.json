{
  "manifest_version": 3,
  "name": "Kite Practice (Paper) – Iron Condor Coach",
  "version": "0.4.0",
  "description": "Kite web ke upar FAKE paper trading + iron condor adjustment coach. Koi asli order nahi lagta.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["https://kite.zerodha.com/*", "https://*.supabase.co/*", "https://api.anthropic.com/*", "https://generativelanguage.googleapis.com/*", "https://query1.finance.yahoo.com/*", "https://api.kite.trade/*", "http://127.0.0.1/*", "https://127.0.0.1/*"],
  "background": { "service_worker": "sync/background.js" },
  "content_scripts": [{
    "matches": ["https://kite.zerodha.com/*"],
    "run_at": "document_idle",
    "js": [
      "engine/pricing.js", "engine/book.js", "engine/analytics.js", "engine/coach.js", "engine/options.js",
      "engine/day.js", "engine/risk.js", "engine/morning.js", "engine/pa.js", "engine/oishift.js",
      "kite/selectors.js", "kite/chainReader.js", "kite/chainButtons.js",
      "feed/demoFeed.js", "ui/panel.js", "app.js"
    ]
  }],
  "web_accessible_resources": [{ "resources": ["ui/panel.css"], "matches": ["https://kite.zerodha.com/*"] }]
}
